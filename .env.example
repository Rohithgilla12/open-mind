DATABASE_URL=postgres://openmind:openmind@localhost:5433/openmind
TEST_DATABASE_URL=postgres://openmind:openmind@localhost:5433/openmind_test
# AI providers. AI_PROVIDERS (comma-ordered fallback chain) supersedes the
# single AI_PROVIDER; the noop provider is the guaranteed floor.
AI_PROVIDER=noop            # noop | gemini | openai (single provider)
AI_PROVIDERS=               # e.g. gemini,openai,noop (ordered fallback chain)
GEMINI_API_KEY=
# OpenAI-compatible provider (also DeepSeek, Groq, Cerebras, Together, Ollama /v1).
OPENAI_BASE_URL=            # default https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=               # required when openai is listed (cheap model, no default)
OPENAI_EMBED_MODEL=         # optional; empty → embeddings unsupported
# Per-provider client-side requests-per-minute caps (optional; unset → no limit).
AI_RPM_GEMINI=
AI_RPM_OPENAI=
# Optional geocoder for places extracted from social-video captions. Unset →
# places are stored by name without coordinates. nominatim uses OSM Nominatim
# (1 req/s client-side cap; set NOMINATIM_EMAIL per its usage policy).
GEOCODER=                   # empty | nominatim | google
NOMINATIM_URL=              # default https://nominatim.openstreetmap.org
NOMINATIM_EMAIL=
GOOGLE_PLACES_API_KEY=      # required when GEOCODER=google (Places API (New))
PORT=8080
# Bearer token guarding the API. Leave empty for single-user local use;
# set a strong secret before exposing the API to a network.
OPENMIND_TOKEN=
# Multi-user auth. AUTH_MODE=token (default) is exactly today's behaviour;
# AUTH_MODE=clerk switches the API to verifying Clerk session JWTs (see
# docs/self-hosting.md#multi-user-mode-clerk before setting this).
AUTH_MODE=token             # token | clerk
CLERK_ISSUER=               # required when AUTH_MODE=clerk — the Clerk Frontend API URL
# Web-side Clerk config, only read when NEXT_PUBLIC_AUTH_MODE=clerk.
NEXT_PUBLIC_AUTH_MODE=token # token | clerk
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Comma-separated CIDRs/IPs of reverse proxies to trust for X-Forwarded-For
# (rate limiting). Empty (default) ignores XFF and limits by the direct
# connection IP. Set to your proxy's source range when behind a reverse proxy.
TRUSTED_PROXIES=
# Contact address shown on the public /privacy and /terms pages. Leave empty
# to show "the operator of this instance" instead of a mailto link.
CONTACT_EMAIL=
# Image upload storage. Blobs live on disk under ASSETS_DIR (the container
# default is /data/assets, backed by the `assetsdata` compose volume; local
# dev uses ./data/assets, which is gitignored). ASSETS_MAX_BYTES caps a single
# upload (default 10 MiB = 10485760).
ASSETS_DIR=./data/assets
ASSETS_MAX_BYTES=10485760
# Send to Kindle. Feature is off unless SMTP_HOST, SMTP_FROM, and KINDLE_EMAIL
# are all set. See docs/self-hosting.md#send-to-kindle for Amazon setup steps.
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=
SMTP_USERNAME=
SMTP_PASSWORD=
KINDLE_EMAIL=
# Optional. TypeSafe Jev for AI-assisted organisation (Phase 1: shadow log only).
# Also requires the per-user setting in the web UI (default off). Sends URL,
# title, site, and a short excerpt — never the full document.
OPENMIND_TYPESAFE_API_KEY=
# Optional. Expo push works unauthenticated; a token adds send-security.
# Create one at https://expo.dev under Account Settings -> Access Tokens.
EXPO_ACCESS_TOKEN=
