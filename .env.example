DATABASE_URL=postgres://openmind:openmind@localhost:5433/openmind
TEST_DATABASE_URL=postgres://openmind:openmind@localhost:5433/openmind_test
# AI providers. AI_PROVIDERS (comma-ordered fallback chain) supersedes the
# single AI_PROVIDER; the noop provider is the guaranteed floor.
AI_PROVIDER=noop            # noop | gemini | openai (single provider)
AI_PROVIDERS=               # e.g. gemini,openai,noop (ordered fallback chain)
GEMINI_API_KEY=
# OpenAI-compatible provider (also DeepSeek, Groq, Cerebras, Together, Ollama /v1).
OPENAI_BASE_URL=            # default https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=               # required when openai is listed (cheap model, no default)
OPENAI_EMBED_MODEL=         # optional; empty → embeddings unsupported
# Per-provider client-side requests-per-minute caps (optional; unset → no limit).
AI_RPM_GEMINI=
AI_RPM_OPENAI=
PORT=8080
# Bearer token guarding the API. Leave empty for single-user local use;
# set a strong secret before exposing the API to a network.
OPENMIND_TOKEN=
# Image upload storage. Blobs live on disk under ASSETS_DIR (the container
# default is /data/assets, backed by the `assetsdata` compose volume; local
# dev uses ./data/assets, which is gitignored). ASSETS_MAX_BYTES caps a single
# upload (default 10 MiB = 10485760).
ASSETS_DIR=./data/assets
ASSETS_MAX_BYTES=10485760
