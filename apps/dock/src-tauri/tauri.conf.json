{
  "$schema": "../../../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "openmind-dock",
  "version": "0.3.0",
  "identifier": "fun.gilla.openmind.dock",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "panel",
        "title": "Openmind",
        "width": 640,
        "height": 420,
        "minWidth": 520,
        "minHeight": 360,
        "visible": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": true,
        "transparent": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {},
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://cdn.crabnebula.app/update/rohith-gilla/openmind/{{target}}-{{arch}}/{{current_version}}"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDE0QkNBRDNENzE1Qzc1QUUKUldTdWRWeHhQYTI4RkhtUU9mOGpzM2g4RGpTR2NTZVltdDVKZU83MlJWSGNpeUZGZHg5ZlhjUEwK"
    }
  }
}
