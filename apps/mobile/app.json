{
  "expo": {
    "name": "Openmind",
    "slug": "openmind",
    "scheme": "openmind",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "fun.gilla.openmind"
    },
    "android": {
      "package": "fun.gilla.openmind",
      "edgeToEdgeEnabled": true
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-web-browser",
      "expo-status-bar",
      [
        "expo-share-intent",
        {
          "iosActivationRules": {
            "NSExtensionActivationSupportsWebURLWithMaxCount": 1,
            "NSExtensionActivationSupportsWebPageWithMaxCount": 1,
            "NSExtensionActivationSupportsText": true
          },
          "androidIntentFilters": [
            "text/*"
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "icon": "./assets/icon.png",
    "splash": {
      "backgroundColor": "#F4F0E6",
      "resizeMode": "contain",
      "image": "./assets/icon.png"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "787dda1f-ef57-4ef9-9a21-c213f656d09d"
      }
    },
    "owner": "gilladude"
  }
}